# Copiar a .env y completar. El .env real esta gitignored.

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgresql://usuario:password@host:5432/rechazos

# --- Chess ERP (Mercosur Distribuciones / Misiones, AR1121) ---
CHESS_BASE_URL=https://mercosurdistribuciones.chesserp.com/AR1121
CHESS_USER=
CHESS_PASS=

# --- GESCOM ---
GESCOM_TOKEN_URL=https://auth.gescom.online/realms/gcw-mercosur/protocol/openid-connect/token
GESCOM_BASE_URL=https://mercosur.gescom.online/data/cmd
GESCOM_CLIENT_ID=gcw-web-api
GESCOM_USER=
GESCOM_PASS=
GESCOM_EMPRESA=99

# --- Seguridad ---
# Protege POST /api/sync. Generar un valor aleatorio largo.
SYNC_SECRET=
# Origenes permitidos para CORS (la URL del frontend). "*" solo en dev.
CORS_ORIGINS=*
